<!--
  Qubit studio: dress your qubits. Nine finishes (some unlocked by level,
  some by achievements), five colour sets, and what each orb shows: the
  probability liquid, the gauge on the desk, the phase ring, the trail.
  UIKit units are cm.
-->
<style>
  .card {
    flex-direction: column;
    width: 470;
    gap: 8;
    padding-top: 18;
    padding-bottom: 16;
    padding-left: 18;
    padding-right: 18;
    background-color: #1b1c1f;
    border-radius: 26;
    border-width: 1;
    border-color: #34363b;
  }
  .head { flex-direction: row; justify-content: space-between; align-items: center; padding-left: 4; padding-right: 2; }
  .titles { flex-direction: column; gap: 2; }
  .eyebrow { font-size: 11; font-weight: 600; color: #8a8d93; }
  .title { font-size: 20; font-weight: 700; color: #f2f3f5; }
  .section { font-size: 11; font-weight: 700; color: #8a8d93; padding-left: 4; padding-top: 4; }
  .grid { flex-direction: row; flex-wrap: wrap; gap: 6; }
  .tile {
    width: 140;
    height: 52;
    flex-direction: column;
    justify-content: center;
    gap: 3;
    padding-left: 10;
    padding-right: 8;
    border-radius: 14;
    border-width: 2;
    border-color: #242528;
    background-color: #242528;
    cursor: pointer;
  }
  .tophalf { flex-direction: row; align-items: center; gap: 7; }
  .swatch {
    width: 16;
    height: 16;
    border-radius: 8;
    border-width: 1;
    border-color: #55585e;
    background-color: #d9e2ef;
  }
  .name { font-size: 12; font-weight: 700; color: #e4e6eb; }
  .meta { font-size: 9; color: #8a8d93; }
  .row { flex-direction: row; gap: 6; flex-wrap: wrap; }
  .pill {
    height: 30;
    padding-left: 12;
    padding-right: 12;
    border-radius: 15;
    flex-direction: row;
    align-items: center;
    gap: 6;
    background-color: #2d2f33;
    cursor: pointer;
  }
  .dot { width: 10; height: 10; border-radius: 5; background-color: #ffffff; }
  .pt { font-size: 11; font-weight: 700; color: #e4e6eb; }
  .btn {
    height: 30;
    padding-left: 12;
    padding-right: 12;
    border-radius: 15;
    align-items: center;
    justify-content: center;
    background-color: #34363b;
    cursor: pointer;
  }
  .bt { font-size: 12; font-weight: 700; color: #e4e6eb; }
  .note { font-size: 10; line-height: 1.4; color: #8a8d93; padding-left: 4; padding-right: 4; }
</style>
<div class="card">
  <div class="head">
    <div class="titles">
      <div id="looks-eyebrow" class="eyebrow">Level 1</div>
      <div class="title">Qubit studio</div>
    </div>
    <div id="looks-close" class="btn"><div class="bt">Close</div></div>
  </div>
  <div class="section">Finish</div>
  <div class="grid">
    <div id="lk-t-0" class="tile"><div class="tophalf"><div id="lk-sw-0" class="swatch"></div><div id="lk-n-0" class="name">-</div></div><div id="lk-m-0" class="meta">-</div></div>
    <div id="lk-t-1" class="tile"><div class="tophalf"><div id="lk-sw-1" class="swatch"></div><div id="lk-n-1" class="name">-</div></div><div id="lk-m-1" class="meta">-</div></div>
    <div id="lk-t-2" class="tile"><div class="tophalf"><div id="lk-sw-2" class="swatch"></div><div id="lk-n-2" class="name">-</div></div><div id="lk-m-2" class="meta">-</div></div>
    <div id="lk-t-3" class="tile"><div class="tophalf"><div id="lk-sw-3" class="swatch"></div><div id="lk-n-3" class="name">-</div></div><div id="lk-m-3" class="meta">-</div></div>
    <div id="lk-t-4" class="tile"><div class="tophalf"><div id="lk-sw-4" class="swatch"></div><div id="lk-n-4" class="name">-</div></div><div id="lk-m-4" class="meta">-</div></div>
    <div id="lk-t-5" class="tile"><div class="tophalf"><div id="lk-sw-5" class="swatch"></div><div id="lk-n-5" class="name">-</div></div><div id="lk-m-5" class="meta">-</div></div>
    <div id="lk-t-6" class="tile"><div class="tophalf"><div id="lk-sw-6" class="swatch"></div><div id="lk-n-6" class="name">-</div></div><div id="lk-m-6" class="meta">-</div></div>
    <div id="lk-t-7" class="tile"><div class="tophalf"><div id="lk-sw-7" class="swatch"></div><div id="lk-n-7" class="name">-</div></div><div id="lk-m-7" class="meta">-</div></div>
    <div id="lk-t-8" class="tile"><div class="tophalf"><div id="lk-sw-8" class="swatch"></div><div id="lk-n-8" class="name">-</div></div><div id="lk-m-8" class="meta">-</div></div>
  </div>
  <div class="section">Colours</div>
  <div class="row">
    <div id="lk-p-0" class="pill"><div id="lk-pd-0" class="dot"></div><div id="lk-pl-0" class="pt">-</div></div>
    <div id="lk-p-1" class="pill"><div id="lk-pd-1" class="dot"></div><div id="lk-pl-1" class="pt">-</div></div>
    <div id="lk-p-2" class="pill"><div id="lk-pd-2" class="dot"></div><div id="lk-pl-2" class="pt">-</div></div>
    <div id="lk-p-3" class="pill"><div id="lk-pd-3" class="dot"></div><div id="lk-pl-3" class="pt">-</div></div>
    <div id="lk-p-4" class="pill"><div id="lk-pd-4" class="dot"></div><div id="lk-pl-4" class="pt">-</div></div>
  </div>
  <div class="section">Show</div>
  <div class="row">
    <div id="lk-o-liquid" class="pill"><div id="lk-o-liquid-l" class="pt">Liquid</div></div>
    <div id="lk-o-gauge" class="pill"><div id="lk-o-gauge-l" class="pt">Gauge</div></div>
    <div id="lk-o-phase" class="pill"><div id="lk-o-phase-l" class="pt">Phase ring</div></div>
    <div id="lk-o-trail" class="pill"><div id="lk-o-trail-l" class="pt">Trail</div></div>
  </div>
  <div id="looks-note" class="note">The liquid is the chance of reading 1: a sure 0 is empty, a sure 1 full, a superposition half full.</div>
</div>

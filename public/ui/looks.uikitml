<!--
  Looks: the orb finishes, unlocked by level, beside the progress board.
  Generated with the other panels in mind; UIKit units are cm.
-->
<style>
  .card {
    flex-direction: column;
    width: 440;
    gap: 9;
    padding-top: 20;
    padding-bottom: 18;
    padding-left: 22;
    padding-right: 22;
    background-color: #1b1c1f;
    border-radius: 26;
    border-width: 1;
    border-color: #34363b;
  }
  .head { flex-direction: row; justify-content: space-between; align-items: center; }
  .titles { flex-direction: column; gap: 2; }
  .eyebrow { font-size: 11; font-weight: 600; color: #8a8d93; }
  .title { font-size: 20; font-weight: 700; color: #f2f3f5; }
  .note { font-size: 12; line-height: 1.4; color: #b8bbc1; }
  .row {
    flex-direction: row;
    align-items: center;
    gap: 10;
    padding-top: 7;
    padding-bottom: 7;
    padding-left: 12;
    padding-right: 8;
    border-radius: 14;
    background-color: #242528;
  }
  .swatch {
    width: 22;
    height: 22;
    border-radius: 11;
    border-width: 2;
    border-color: #55585e;
    background-color: #d9e2ef;
  }
  .names { flex-direction: column; flex-grow: 1; gap: 2; }
  .name { font-size: 13; font-weight: 600; color: #e4e6eb; }
  .meta { font-size: 11; color: #8a8d93; }
  .btn {
    height: 30;
    padding-left: 12;
    padding-right: 12;
    border-radius: 15;
    align-items: center;
    justify-content: center;
    background-color: #34363b;
    cursor: pointer;
  }
  .bt { font-size: 12; font-weight: 700; color: #e4e6eb; }
</style>
<div class="card">
  <div class="head">
    <div class="titles">
      <div id="looks-eyebrow" class="eyebrow">Level 1</div>
      <div class="title">Orb finish</div>
    </div>
    <div id="looks-close" class="btn"><div class="bt">Close</div></div>
  </div>
  <div id="looks-r-0" class="row">
    <div id="looks-sw-0" class="swatch"></div>
    <div class="names"><div id="looks-n-0" class="name">-</div><div id="looks-m-0" class="meta">-</div></div>
    <div id="looks-b-0" class="btn"><div id="looks-bl-0" class="bt">Wear</div></div>
  </div>
  <div id="looks-r-1" class="row">
    <div id="looks-sw-1" class="swatch"></div>
    <div class="names"><div id="looks-n-1" class="name">-</div><div id="looks-m-1" class="meta">-</div></div>
    <div id="looks-b-1" class="btn"><div id="looks-bl-1" class="bt">Wear</div></div>
  </div>
  <div id="looks-r-2" class="row">
    <div id="looks-sw-2" class="swatch"></div>
    <div class="names"><div id="looks-n-2" class="name">-</div><div id="looks-m-2" class="meta">-</div></div>
    <div id="looks-b-2" class="btn"><div id="looks-bl-2" class="bt">Wear</div></div>
  </div>
  <div id="looks-r-3" class="row">
    <div id="looks-sw-3" class="swatch"></div>
    <div class="names"><div id="looks-n-3" class="name">-</div><div id="looks-m-3" class="meta">-</div></div>
    <div id="looks-b-3" class="btn"><div id="looks-bl-3" class="bt">Wear</div></div>
  </div>
  <div id="looks-r-4" class="row">
    <div id="looks-sw-4" class="swatch"></div>
    <div class="names"><div id="looks-n-4" class="name">-</div><div id="looks-m-4" class="meta">-</div></div>
    <div id="looks-b-4" class="btn"><div id="looks-bl-4" class="bt">Wear</div></div>
  </div>
  <div id="looks-note" class="note">Level up to unlock more: finish chapters, lessons, puzzles and daily challenges, and earn achievements.</div>
</div>

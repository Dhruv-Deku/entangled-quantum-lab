<!--
  Notes: the longer plain-English explanation for the current chapter, lesson
  or the builder, a page at a time, with a read-aloud button. UIKit units are cm.
-->
<style>
  .card {
    flex-direction: column;
    width: 440;
    min-height: 330;
    gap: 10;
    padding-top: 20;
    padding-bottom: 18;
    padding-left: 24;
    padding-right: 24;
    background-color: #1b1c1f;
    border-radius: 26;
    border-width: 1;
    border-color: #34363b;
  }
  .head { flex-direction: row; justify-content: space-between; align-items: center; }
  .eyebrow { font-size: 11; font-weight: 600; color: #8a8d93; }
  .title { font-size: 22; font-weight: 700; color: #f2f3f5; }
  .p { font-size: 14; line-height: 1.45; color: #c9ccd1; }
  .key { font-size: 14; line-height: 1.45; font-weight: 600; color: #3ddc97; }
  .row { flex-direction: row; gap: 8; margin-top: 6; }
  .btn {
    height: 36;
    padding-left: 16;
    padding-right: 16;
    border-radius: 18;
    align-items: center;
    justify-content: center;
    background-color: #34363b;
    cursor: pointer;
  }
  .bt { font-size: 13; font-weight: 600; color: #e4e6eb; }
</style>
<div class="card">
  <div class="head">
    <div id="notes-eyebrow" class="eyebrow">Notes</div>
    <div id="notes-page" class="eyebrow">1 of 1</div>
  </div>
  <div id="notes-title" class="title">Notes</div>
  <div id="notes-p-0" class="p">-</div>
  <div id="notes-p-1" class="p">-</div>
  <div id="notes-p-2" class="p">-</div>
  <div class="row">
    <div id="notes-prev" class="btn"><div class="bt">Back</div></div>
    <div id="notes-next" class="btn"><div id="notes-next-label" class="bt">Next</div></div>
    <div id="notes-listen" class="btn"><div id="notes-listen-label" class="bt">Listen</div></div>
    <div id="notes-zoom" class="btn"><div id="notes-zoom-label" class="bt">Zoom</div></div>
    <div id="notes-close" class="btn"><div class="bt">Close</div></div>
  </div>
</div>

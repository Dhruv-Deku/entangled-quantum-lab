<!--
  Code window: the circuit as Qiskit, OpenQASM 3 or PennyLane, a page at a time,
  with Zoom. Generated by scripts/gen-code-panel.py; edit that instead.
  UIKit units are cm.
-->
<style>
  .card {
    flex-direction: column;
    width: 420;
    gap: 10;
    padding-top: 18;
    padding-bottom: 18;
    padding-left: 20;
    padding-right: 20;
    background-color: #1b1c1f;
    border-radius: 24;
    border-width: 1;
    border-color: #34363b;
  }
  .head { flex-direction: row; justify-content: space-between; align-items: center; }
  .titles { flex-direction: column; gap: 2; }
  .eyebrow { font-size: 11; font-weight: 600; color: #8a8d93; }
  .title { font-size: 18; font-weight: 700; color: #f2f3f5; }
  .btns { flex-direction: row; gap: 6; align-items: center; }
  .btn {
    height: 32;
    padding-left: 13;
    padding-right: 13;
    border-radius: 16;
    align-items: center;
    justify-content: center;
    background-color: #34363b;
    cursor: pointer;
  }
  .bt { font-size: 12; font-weight: 600; color: #e4e6eb; }
  .tabs {
    flex-direction: row;
    gap: 4;
    padding-top: 4;
    padding-bottom: 4;
    padding-left: 4;
    padding-right: 4;
    border-radius: 20;
    background-color: #242528;
  }
  .tab {
    flex-grow: 1;
    height: 30;
    border-radius: 15;
    align-items: center;
    justify-content: center;
    background-color: #242528;
    cursor: pointer;
  }
  .tl { font-size: 12; font-weight: 700; color: #8a8d93; }
  .note { font-size: 11; color: #8a8d93; }
  .code {
    flex-direction: column;
    gap: 3;
    padding-top: 10;
    padding-bottom: 10;
    padding-left: 10;
    padding-right: 10;
    border-radius: 14;
    background-color: #141517;
  }
  .row { flex-direction: row; align-items: center; }
  .no { width: 18; margin-right: 8; font-size: 10; color: #55585e; text-align: right; }
  .hd { font-size: 12; font-weight: 600; color: #8fb7ff; }
  .ln { font-size: 12; color: #c9ccd1; }
  .foot { flex-direction: row; justify-content: space-between; align-items: center; }
  .mach { flex-direction: row; gap: 6; align-items: center; }
</style>
<div class="card">
  <div class="head">
    <div class="titles">
      <div id="code-eyebrow" class="eyebrow">Code</div>
      <div id="code-title" class="title">Your circuit</div>
    </div>
    <div class="btns">
      <div id="code-edit" class="btn"><div class="bt">Edit</div></div>
      <div id="code-zoom" class="btn"><div id="code-zoom-label" class="bt">Zoom</div></div>
      <div id="code-close" class="btn"><div class="bt">Close</div></div>
    </div>
  </div>
  <div class="tabs">
    <div id="code-tab-qiskit" class="tab"><div id="code-tab-qiskit-l" class="tl">Qiskit</div></div>
    <div id="code-tab-qasm" class="tab"><div id="code-tab-qasm-l" class="tl">QASM 3</div></div>
    <div id="code-tab-pennylane" class="tab"><div id="code-tab-pennylane-l" class="tl">PennyLane</div></div>
    <div id="code-tab-chip" class="tab"><div id="code-tab-chip-l" class="tl">On chip</div></div>
    <div id="code-tab-maths" class="tab"><div id="code-tab-maths-l" class="tl">Maths</div></div>
  </div>
  <div id="code-note" class="note">-</div>
  <div class="code">
    <div id="code-r-0" class="row"><div id="code-n-0" class="no">1</div><div id="code-h-0" class="hd">-</div><div id="code-t-0" class="ln">-</div></div>
    <div id="code-r-1" class="row"><div id="code-n-1" class="no">2</div><div id="code-h-1" class="hd">-</div><div id="code-t-1" class="ln">-</div></div>
    <div id="code-r-2" class="row"><div id="code-n-2" class="no">3</div><div id="code-h-2" class="hd">-</div><div id="code-t-2" class="ln">-</div></div>
    <div id="code-r-3" class="row"><div id="code-n-3" class="no">4</div><div id="code-h-3" class="hd">-</div><div id="code-t-3" class="ln">-</div></div>
    <div id="code-r-4" class="row"><div id="code-n-4" class="no">5</div><div id="code-h-4" class="hd">-</div><div id="code-t-4" class="ln">-</div></div>
    <div id="code-r-5" class="row"><div id="code-n-5" class="no">6</div><div id="code-h-5" class="hd">-</div><div id="code-t-5" class="ln">-</div></div>
    <div id="code-r-6" class="row"><div id="code-n-6" class="no">7</div><div id="code-h-6" class="hd">-</div><div id="code-t-6" class="ln">-</div></div>
    <div id="code-r-7" class="row"><div id="code-n-7" class="no">8</div><div id="code-h-7" class="hd">-</div><div id="code-t-7" class="ln">-</div></div>
    <div id="code-r-8" class="row"><div id="code-n-8" class="no">9</div><div id="code-h-8" class="hd">-</div><div id="code-t-8" class="ln">-</div></div>
    <div id="code-r-9" class="row"><div id="code-n-9" class="no">10</div><div id="code-h-9" class="hd">-</div><div id="code-t-9" class="ln">-</div></div>
  </div>
  <div id="code-mach" class="mach">
    <div id="code-m-superconducting" class="btn"><div class="bt">Chip</div></div>
    <div id="code-m-ions" class="btn"><div class="bt">Ions</div></div>
    <div id="code-m-atoms" class="btn"><div class="bt">Atoms</div></div>
    <div id="code-compare" class="btn"><div class="bt">Compare</div></div>
    <div id="code-full" class="btn"><div class="bt">Full size</div></div>
  </div>
  <div class="foot">
    <div class="btns">
      <div id="code-up" class="btn"><div class="bt">Back</div></div>
      <div id="code-down" class="btn"><div class="bt">More</div></div>
    </div>
    <div class="btns">
      <div id="code-simplify" class="btn"><div id="code-simplify-label" class="bt">Simplify</div></div>
      <div id="code-run" class="btn"><div class="bt">Run on chip</div></div>
      <div id="code-ibm" class="btn"><div id="code-ibm-l" class="bt">Run on IBM</div></div>
      <div id="code-link" class="btn"><div class="bt">Copy link</div></div>
    </div>
  </div>
</div>

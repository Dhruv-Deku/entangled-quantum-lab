<!--
  Code Lab: write your own program in OpenQASM 3 with a token keyboard (no
  typing needed in a headset). Generated by scripts/gen-codelab-panel.py; edit
  that instead. UIKit units are cm.
-->
<style>
  .card {
    flex-direction: column;
    width: 460;
    gap: 8;
    padding-top: 18;
    padding-bottom: 16;
    padding-left: 18;
    padding-right: 18;
    background-color: #1b1c1f;
    border-radius: 24;
    border-width: 1;
    border-color: #34363b;
  }
  .head { flex-direction: row; justify-content: space-between; align-items: center; }
  .titles { flex-direction: column; gap: 2; }
  .eyebrow { font-size: 11; font-weight: 600; color: #8a8d93; }
  .title { font-size: 18; font-weight: 700; color: #f2f3f5; }
  .btns { flex-direction: row; gap: 6; align-items: center; }
  .btn {
    height: 30;
    padding-left: 13;
    padding-right: 13;
    border-radius: 15;
    align-items: center;
    justify-content: center;
    background-color: #34363b;
    cursor: pointer;
  }
  .bt { font-size: 12; font-weight: 700; color: #e4e6eb; }
  .code {
    flex-direction: column;
    gap: 2;
    padding-top: 8;
    padding-bottom: 8;
    padding-left: 8;
    padding-right: 8;
    border-radius: 14;
    background-color: #141517;
  }
  .line { flex-direction: row; align-items: center; padding-left: 4; border-radius: 6; }
  .no { width: 18; margin-right: 8; font-size: 10; color: #55585e; text-align: right; }
  .ln { font-size: 12; color: #c9ccd1; }
  .status { font-size: 11; color: #8a8d93; }
  .keys { flex-direction: row; gap: 5; flex-wrap: wrap; }
  .key {
    height: 26;
    padding-left: 9;
    padding-right: 9;
    border-radius: 13;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .gate { background-color: #2c3a52; }
  .arg { background-color: #2f3135; }
  .edit { background-color: #26272b; }
  .kt { font-size: 11; font-weight: 700; color: #e4e6eb; }
</style>
<div class="card">
  <div class="head">
    <div class="titles">
      <div id="lab-eyebrow" class="eyebrow">Code Lab</div>
      <div class="title">Your program</div>
    </div>
    <div class="btns">
      <div id="lab-step" class="btn"><div class="bt">Step</div></div>
      <div id="lab-run" class="btn"><div class="bt">Run</div></div>
      <div id="lab-close" class="btn"><div class="bt">Close</div></div>
    </div>
  </div>
  <div class="code">
    <div id="lab-r-0" class="line"><div id="lab-n-0" class="no">1</div><div id="lab-t-0" class="ln">-</div></div>
    <div id="lab-r-1" class="line"><div id="lab-n-1" class="no">2</div><div id="lab-t-1" class="ln">-</div></div>
    <div id="lab-r-2" class="line"><div id="lab-n-2" class="no">3</div><div id="lab-t-2" class="ln">-</div></div>
    <div id="lab-r-3" class="line"><div id="lab-n-3" class="no">4</div><div id="lab-t-3" class="ln">-</div></div>
    <div id="lab-r-4" class="line"><div id="lab-n-4" class="no">5</div><div id="lab-t-4" class="ln">-</div></div>
    <div id="lab-r-5" class="line"><div id="lab-n-5" class="no">6</div><div id="lab-t-5" class="ln">-</div></div>
    <div id="lab-r-6" class="line"><div id="lab-n-6" class="no">7</div><div id="lab-t-6" class="ln">-</div></div>
    <div id="lab-r-7" class="line"><div id="lab-n-7" class="no">8</div><div id="lab-t-7" class="ln">-</div></div>
    <div id="lab-r-8" class="line"><div id="lab-n-8" class="no">9</div><div id="lab-t-8" class="ln">-</div></div>
    <div id="lab-r-9" class="line"><div id="lab-n-9" class="no">10</div><div id="lab-t-9" class="ln">-</div></div>
  </div>
  <div id="lab-status" class="status">Tap a gate, then its qubits.</div>
  <div class="keys">
    <div id="lab-k-h" class="key gate"><div class="kt">h</div></div>
    <div id="lab-k-x" class="key gate"><div class="kt">x</div></div>
    <div id="lab-k-y" class="key gate"><div class="kt">y</div></div>
    <div id="lab-k-z" class="key gate"><div class="kt">z</div></div>
    <div id="lab-k-s" class="key gate"><div class="kt">s</div></div>
    <div id="lab-k-sdg" class="key gate"><div class="kt">sdg</div></div>
    <div id="lab-k-t" class="key gate"><div class="kt">t</div></div>
    <div id="lab-k-tdg" class="key gate"><div class="kt">tdg</div></div>
  </div>
  <div class="keys">
    <div id="lab-k-rx" class="key gate"><div class="kt">rx</div></div>
    <div id="lab-k-ry" class="key gate"><div class="kt">ry</div></div>
    <div id="lab-k-rz" class="key gate"><div class="kt">rz</div></div>
    <div id="lab-k-cx" class="key gate"><div class="kt">cx</div></div>
    <div id="lab-k-cz" class="key gate"><div class="kt">cz</div></div>
    <div id="lab-k-swap" class="key gate"><div class="kt">swap</div></div>
    <div id="lab-k-ccx" class="key gate"><div class="kt">ccx</div></div>
    <div id="lab-k-measure" class="key gate"><div class="kt">measure</div></div>
  </div>
  <div class="keys">
    <div id="lab-k-q0" class="key arg"><div class="kt">q0</div></div>
    <div id="lab-k-q1" class="key arg"><div class="kt">q1</div></div>
    <div id="lab-k-q2" class="key arg"><div class="kt">q2</div></div>
    <div id="lab-k-q3" class="key arg"><div class="kt">q3</div></div>
    <div id="lab-k-q4" class="key arg"><div class="kt">q4</div></div>
    <div id="lab-k-pi" class="key arg"><div class="kt">pi</div></div>
    <div id="lab-k-pi2" class="key arg"><div class="kt">pi/2</div></div>
    <div id="lab-k-pi4" class="key arg"><div class="kt">pi/4</div></div>
    <div id="lab-k-mpi2" class="key arg"><div class="kt">-pi/2</div></div>
  </div>
  <div class="keys">
    <div id="lab-k-up" class="key edit"><div class="kt">Up</div></div>
    <div id="lab-k-down" class="key edit"><div class="kt">Down</div></div>
    <div id="lab-k-delete" class="key edit"><div class="kt">Delete</div></div>
    <div id="lab-k-clear" class="key edit"><div class="kt">Clear</div></div>
    <div id="lab-k-link" class="key edit"><div class="kt">Link</div></div>
  </div>
  <div class="keys">
    <div id="lab-k-subqubit" class="key edit"><div class="kt">- qubit</div></div>
    <div id="lab-k-addqubit" class="key edit"><div class="kt">+ qubit</div></div>
    <div id="lab-k-example" class="key edit"><div class="kt">Example</div></div>
    <div id="lab-k-fromorbs" class="key edit"><div class="kt">From orbs</div></div>
  </div>
</div>

<!--
  The decoder game's tap pad: one button per data qubit, laid out like the
  lattice. Generated by scripts/gen-decoder-panel.py. UIKit units are cm.
-->
<style>
  .card {
    flex-direction: column;
    gap: 10;
    padding-top: 16;
    padding-bottom: 16;
    padding-left: 18;
    padding-right: 18;
    background-color: #1b1c1f;
    border-radius: 24;
    border-width: 1;
    border-color: #34363b;
    align-items: center;
  }
  .eyebrow { font-size: 11; font-weight: 600; color: #8a8d93; }
  .title { font-size: 16; font-weight: 700; color: #f2f3f5; }
  .grid { flex-direction: column; gap: 8; }
  .row { flex-direction: row; gap: 8; }
  .q {
    width: 44;
    height: 44;
    border-radius: 22;
    align-items: center;
    justify-content: center;
    background-color: #2f3135;
    cursor: pointer;
  }
  .ql { font-size: 13; font-weight: 700; color: #e4e6eb; }
  .note { font-size: 11; color: #8a8d93; }
</style>
<div class="card">
  <div id="dec-eyebrow" class="eyebrow">Be the decoder</div>
  <div class="title">Tap qubits to flip them</div>
  <div class="grid">
    <div id="dec-r-0" class="row">
      <div id="dec-b-0-0" class="q"><div id="dec-l-0-0" class="ql">.</div></div>
      <div id="dec-b-0-1" class="q"><div id="dec-l-0-1" class="ql">.</div></div>
      <div id="dec-b-0-2" class="q"><div id="dec-l-0-2" class="ql">.</div></div>
      <div id="dec-b-0-3" class="q"><div id="dec-l-0-3" class="ql">.</div></div>
      <div id="dec-b-0-4" class="q"><div id="dec-l-0-4" class="ql">.</div></div>
    </div>
    <div id="dec-r-1" class="row">
      <div id="dec-b-1-0" class="q"><div id="dec-l-1-0" class="ql">.</div></div>
      <div id="dec-b-1-1" class="q"><div id="dec-l-1-1" class="ql">.</div></div>
      <div id="dec-b-1-2" class="q"><div id="dec-l-1-2" class="ql">.</div></div>
      <div id="dec-b-1-3" class="q"><div id="dec-l-1-3" class="ql">.</div></div>
      <div id="dec-b-1-4" class="q"><div id="dec-l-1-4" class="ql">.</div></div>
    </div>
    <div id="dec-r-2" class="row">
      <div id="dec-b-2-0" class="q"><div id="dec-l-2-0" class="ql">.</div></div>
      <div id="dec-b-2-1" class="q"><div id="dec-l-2-1" class="ql">.</div></div>
      <div id="dec-b-2-2" class="q"><div id="dec-l-2-2" class="ql">.</div></div>
      <div id="dec-b-2-3" class="q"><div id="dec-l-2-3" class="ql">.</div></div>
      <div id="dec-b-2-4" class="q"><div id="dec-l-2-4" class="ql">.</div></div>
    </div>
    <div id="dec-r-3" class="row">
      <div id="dec-b-3-0" class="q"><div id="dec-l-3-0" class="ql">.</div></div>
      <div id="dec-b-3-1" class="q"><div id="dec-l-3-1" class="ql">.</div></div>
      <div id="dec-b-3-2" class="q"><div id="dec-l-3-2" class="ql">.</div></div>
      <div id="dec-b-3-3" class="q"><div id="dec-l-3-3" class="ql">.</div></div>
      <div id="dec-b-3-4" class="q"><div id="dec-l-3-4" class="ql">.</div></div>
    </div>
    <div id="dec-r-4" class="row">
      <div id="dec-b-4-0" class="q"><div id="dec-l-4-0" class="ql">.</div></div>
      <div id="dec-b-4-1" class="q"><div id="dec-l-4-1" class="ql">.</div></div>
      <div id="dec-b-4-2" class="q"><div id="dec-l-4-2" class="ql">.</div></div>
      <div id="dec-b-4-3" class="q"><div id="dec-l-4-3" class="ql">.</div></div>
      <div id="dec-b-4-4" class="q"><div id="dec-l-4-4" class="ql">.</div></div>
    </div>
  </div>
  <div id="dec-note" class="note">Clear every lit check.</div>
</div>
